{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    // example:lib
    "paths": {
      "@monorepo/shared": ["./packages/shared/src"],
      "@monorepo/shared/*": ["./packages/shared/src/*"],
      "@monorepo/lib": ["./packages/lib/src"],
      "@monorepo/lib/*": ["./packages/lib/src/*"]
    },
    // /example:lib
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node16",
    "module": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": ["node_modules"],
  "files": []
}
