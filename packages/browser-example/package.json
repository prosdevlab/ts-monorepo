{
  "name": "@monorepo/browser-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json",
    "lint": "biome lint ./src ./e2e",
    "format": "biome format --write ./src ./e2e",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "script tag (index.global.js)",
      "path": "dist/index.global.js",
      "limit": "1 KB"
    }
  ],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
