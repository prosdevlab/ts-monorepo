{
  "name": "@monorepo/web",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json && rollup -c",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json",
    "lint": "biome lint ./src ./e2e",
    "format": "biome format --write ./src ./e2e",
    "size": "size-limit",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "test:browser": "playwright test"
  },
  "size-limit": [
    {
      "name": "web script tag (index.global.js)",
      "path": "dist/index.global.js",
      "limit": "1 KB"
    }
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@rollup/plugin-terser": "1.0.2",
    "@size-limit/file": "14.3.0",
    "rollup": "4.65.0",
    "size-limit": "14.3.0",
    "typescript": "7.0.2"
  }
}
