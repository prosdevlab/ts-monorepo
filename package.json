{
  "name": "ts-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "size": "pnpm -r --if-present run size",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "lint-staged": "biome check --write --no-errors-on-unmatched",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.64.0",
    "@size-limit/file": "14.2.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "husky": "^9.1.7",
    "size-limit": "14.2.0",
    "tsup": "^8.5.1",
    "turbo": "2.11.7",
    "typescript": "^5.9.3",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.12.0",
    "pnpm": "10.26.2"
  }
}
