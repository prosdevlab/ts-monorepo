{
  "name": "ts-monorepo-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "turbo test:browser",
    "size": "turbo size",
    "check:packages": "turbo check:package",
    "check:unused": "knip",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "lint-staged": "biome check --write --no-errors-on-unmatched",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "pkg-pr-new": "0.0.92",
    "publint": "0.3.25",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  }
}
