{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "internalChecksFilter": "strict",
  "rangeStrategy": "pin",
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "One PR for all GitHub Actions minor and patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "One PR for dev-tool minor and patch updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies"
    },
    {
      "description": "Root tooling: keep @types/node on the Node major that devEngines.runtime pins; raise both together",
      "matchPackageNames": ["@types/node"],
      "matchFileNames": ["package.json"],
      "allowedVersions": "26.x"
    },
    {
      "description": "Published packages: keep @types/node on the oldest Node major they support (engines.node); raise both together",
      "matchPackageNames": ["@types/node"],
      "matchFileNames": ["packages/**"],
      "allowedVersions": "24.x"
    }
  ]
}
